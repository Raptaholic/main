{
  // Committing this config stops Cloudflare's autoconfig from guessing.
  // The site is plain static assets; only index.html, _headers, pics/ and
  // vendor/ are served (everything else is excluded via .assetsignore).
  "name": "novupeptides",
  "compatibility_date": "2026-07-05",
  "assets": { "directory": "." }
}
